// Copy to Config/Secrets.xcconfig (gitignored) and fill in. See README → "Configure Google sign-in".

// Google Cloud Console → Credentials → OAuth client ID (type iOS).
GOOGLE_CLIENT_ID = REPLACE_ME
// The "iOS URL scheme" shown for that client (the client ID reversed).
GOOGLE_REVERSED_CLIENT_ID = com.googleusercontent.apps.REPLACE_ME

// PostHog project API key (EU cloud). Leave REPLACE_ME to disable analytics.
POSTHOG_API_KEY = REPLACE_ME

// Apple Developer Team ID (10 characters) for signing. Needed for the Keychain and the App Store.
TEAM_ID = REPLACE_ME
HEYYOU_SIGN_IDENTITY = Apple Development
